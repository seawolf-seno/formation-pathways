# Copy to .env.local and fill in to enable live Claude calls.
# Without this, the app runs fully offline using canned fallback drafts
# (per CLAUDE.md: every Claude call has a canned-fallback path).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# System of record (consented pilot — /pilot, /capture). Browser-safe anon
# key: every query runs as the signed-in staff member under Postgres RLS.
# Setup steps: docs/system-of-record.md
NEXT_PUBLIC_SUPABASE_URL=https://cvppxixatcreyptpkymh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pilot live imports. Each source stays on fixtures/sample/* until these are
# set AND leadership sign-off is recorded on /pilot. Finalsite goes live by
# uploading a report export CSV on /pilot (no credentials needed here).
BLACKBAUD_SUBSCRIPTION_KEY=
BLACKBAUD_ACCESS_TOKEN=
# Comma-separated Canvas course ids the pilot may read (uses CANVAS_BASE_URL
# and CANVAS_API_TOKEN below).
CANVAS_PILOT_COURSE_IDS=

# Supabase project "Formation Pathways" — used only for admissions stories.
# Server-only: SUPABASE_SERVICE_ROLE_KEY must never be exposed client-side.
SUPABASE_URL=https://cvppxixatcreyptpkymh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Canvas + Google Drive integrations (Courses / skill snapshots).
# MOCK_INTEGRATIONS is on by default (any value other than "false") — the
# demo always runs on realistic seeded data. Set to "false" AND fill in the
# credentials below to test a live sync against a sandbox course, never a
# real roster, until privacy sign-off (see CLAUDE.md).
MOCK_INTEGRATIONS=true
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
