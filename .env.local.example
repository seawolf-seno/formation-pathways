# Copy to .env.local and fill in to enable live Claude calls.
# Without this, the app runs fully offline using canned fallback drafts
# (per CLAUDE.md: every Claude call has a canned-fallback path).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# System of record (consented pilot — /pilot, /capture). Browser-safe anon
# key: every query runs as the signed-in staff member under Postgres RLS.
# Setup steps: docs/system-of-record.md
NEXT_PUBLIC_SUPABASE_URL=https://cvppxixatcreyptpkymh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pilot live imports. Each source stays on fixtures/sample/* until these are
# set AND leadership sign-off is recorded on /pilot. Finalsite goes live by
# uploading a report export CSV on /pilot (no credentials needed here).
BLACKBAUD_SUBSCRIPTION_KEY=
# SKY app (developer.blackbaud.com → My applications): Application ID and
# primary application secret. Register <origin>/auth/blackbaud/callback as a
# redirect URI, and have a Blackbaud environment admin connect the app. Then
# use "Connect Blackbaud" on /pilot (60-minute token, that browser only).
BLACKBAUD_CLIENT_ID=
BLACKBAUD_CLIENT_SECRET=
# Optional fallback for local runs: a pasted 60-minute token.
BLACKBAUD_ACCESS_TOKEN=
# Comma-separated Canvas course ids the pilot may read (uses CANVAS_BASE_URL
# and CANVAS_API_TOKEN below).
CANVAS_PILOT_COURSE_IDS=

# Admissions season dashboard (/season): live whole-school COUNTS from the
# Finalsite Enrollment External API. Read-only; only suppressed totals are
# stored. Stays on sample figures until these are set AND an admin saves the
# approval on /season. Credentials: Finalsite EMS → Settings → Fields & Data →
# External API Documentation (the Swagger page there also lists the endpoint
# path and field names — match FINALSITE_FUNNEL_FIELDS in
# lib/sor/importers/finalsite-api.ts to it). Never commit real values.
# Pacifica: https://pacificachristian.fsenrollment.com (no /api suffix)
FINALSITE_API_BASE_URL=
FINALSITE_API_CREDENTIAL_ID=
FINALSITE_API_SECRET=
# Optional: X-Api-Version header, list endpoint (default /api/external/contacts), and
# extra query string to narrow it (e.g. to recent entry years).
FINALSITE_API_VERSION=
FINALSITE_FUNNEL_PATH=
FINALSITE_FUNNEL_QUERY=
# "Admitted" comes from each season's status, dated by the day decisions were
# released (Finalsite has no decision date on a contact). The admissions
# office confirms both. Entry year = the fall the class enters.
# FINALSITE_ADMITTED_STATUSES=accepted,admitted,enrollment_in_progress,enrolled
# FINALSITE_DECISION_DATES=2024=2024-03-08,2025=2025-03-07,2026=2026-03-06
FINALSITE_ADMITTED_STATUSES=
FINALSITE_DECISION_DATES=
# Optional: skip school-year discovery, e.g. 2027=<uuid>,2026=<uuid>
FINALSITE_SCHOOL_YEAR_IDS=

# Supabase project "Formation Pathways" — used only for admissions stories.
# Server-only: SUPABASE_SERVICE_ROLE_KEY must never be exposed client-side.
SUPABASE_URL=https://cvppxixatcreyptpkymh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Canvas + Google Drive integrations (Courses / skill snapshots).
# MOCK_INTEGRATIONS is on by default (any value other than "false") — the
# demo always runs on realistic seeded data. Set to "false" AND fill in the
# credentials below to test a live sync against a sandbox course, never a
# real roster, until privacy sign-off (see CLAUDE.md).
MOCK_INTEGRATIONS=true
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
