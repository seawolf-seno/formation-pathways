{
  "manifest_version": 3,
  "name": "Pacifica Mastery Hub",
  "version": "0.2.0",
  "description": "Sends your Khan Academy key skills to the Formation Pathways Mastery Hub, and tags pages as resources for your classes.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://classroom.khanacademy.org/*",
    "https://formation-pathways.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": ["https://*.vercel.app/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Mastery Hub" },
  "content_scripts": [
    {
      "matches": ["https://classroom.khanacademy.org/teacher/class/*"],
      "js": ["khan-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://classroom.khanacademy.org/teacher/class/*"],
      "js": ["khan-relay.js"],
      "run_at": "document_start"
    }
  ]
}
