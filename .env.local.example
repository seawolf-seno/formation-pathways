# Copy to .env.local and fill in to enable live Claude calls.
# Without this, the app runs fully offline using canned fallback drafts
# (per CLAUDE.md: every Claude call has a canned-fallback path).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase project "Formation Pathways" — used only for admissions stories.
# Server-only: SUPABASE_SERVICE_ROLE_KEY must never be exposed client-side.
SUPABASE_URL=https://cvppxixatcreyptpkymh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Canvas + Google Drive integrations (Courses / skill snapshots).
# MOCK_INTEGRATIONS is on by default (any value other than "false") — the
# demo always runs on realistic seeded data. Set to "false" AND fill in the
# credentials below to test a live sync against a sandbox course, never a
# real roster, until privacy sign-off (see CLAUDE.md).
MOCK_INTEGRATIONS=true
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
